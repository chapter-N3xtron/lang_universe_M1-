# Ollama Cloud native API (https://ollama.com/api)
LLM_BASE_URL=https://ollama.com
LLM_API_KEY=your-ollama-cloud-api-key-here

# Ollama Cloud model names (provider prefix optional, stripped by llm.py)
CHAT_UI_MODEL=glm-5.2
# Deep Agents coding backend
AGENT_WORKSPACE=/path/to/your/project
CODING_MODEL=openai/gpt-5.6-terra
CODING_MODELS=openai/gpt-5.6-terra
CODING_MODEL_PROVIDER=openai
CODING_OLLAMA_BASE_URL=http://127.0.0.1:11434
CODING_OLLAMA_CLOUD_BASE_URL=https://ollama.com
CODING_OLLAMA_NUM_CTX=8192
CODING_OLLAMA_NUM_PREDICT=256
CODING_AGENT_TIMEOUT_SECONDS=240
CODING_CHECKPOINT_FILE=./data/deep_agents_checkpoints.sqlite3
# Optional Postgres override. Leave empty to use the durable SQLite file above.
CODING_CHECKPOINT_DB_URI=

# Optional providers. Keep real values only in .env or your secret manager.
OPENAI_API_KEY=
OLLAMA_API_KEY=
HUGGINGFACEHUB_API_TOKEN=
