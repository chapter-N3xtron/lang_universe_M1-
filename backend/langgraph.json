{
  "python_version": "3.12",
  "dockerfile_lines": [
    "COPY --from=node:22-bookworm-slim /usr/local /usr/local",
    "COPY --from=docker:27.5.1-cli /usr/local/bin/docker /usr/local/bin/docker",
    "COPY --from=docker:27.5.1-cli /usr/local/libexec/docker/cli-plugins /usr/local/libexec/docker/cli-plugins",
    "RUN rm -f /usr/local/bin/yarn /usr/local/bin/yarnpkg /usr/local/bin/pnpm /usr/local/bin/pnpx && corepack enable && corepack prepare pnpm@10.5.1 --activate",
    "ENV NPM_CONFIG_PREFIX=/opt/coding-tools/node",
    "ENV PNPM_HOME=/opt/coding-tools/pnpm",
    "ENV PATH=/opt/coding-tools/node/bin:/opt/coding-tools/pnpm:${PATH}"
  ],
  "dependencies": [
    "."
  ],
  "graphs": {
    "chat_ui": "./src/chat_ui.py:create_chat_ui"
  },
  "http": {
    "app": "./src/runtime_identity.py:app"
  },
  "env": "./.env"
}
