__pycache__/
*.py[cod]
*.so
*.egg-info/
.venv/
venv/

# model caches / audio artifacts
*.wav
*.mp3
*.webm
*.onnx
*.pt
*.pth
*.ckpt
*.bin

# IDE / OS
.DS_Store
.vscode/
.idea/
