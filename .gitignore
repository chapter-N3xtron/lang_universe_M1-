# environment
.env
.env.local
.env.production
.env.development
!.env.example

# logs
*.log

# generated image artifacts / order records
image_orders/

# character profile examples (keep tracked only if explicitly chosen)
# image_profiles/

# misc
.DS_Store
*.pem
*.pid
*.bak
*.restored
*.old
*.sqlite
*.sqlite-shm
*.sqlite-wal

# runtime data
/data/
backend/data/
backend/logs/
frontend/logs/

