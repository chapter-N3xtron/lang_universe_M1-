# Copy to .env locally; never commit .env and never put credentials here in source control.
PLANE_VERSION=v1.26.0
PLANE_UI_PORT=8080
PLANE_DB_USER=plane
PLANE_DB_NAME=plane
PLANE_DB_PASSWORD=replace-with-a-local-random-value
PLANE_OBJECT_STORAGE_USER=plane-local
PLANE_OBJECT_STORAGE_PASSWORD=replace-with-a-third-local-random-value
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_NAME=temporal
TEMPORAL_DB_PASSWORD=replace-with-a-different-local-random-value
TEMPORAL_GRPC_PORT=7233
TEMPORAL_UI_PORT=8088
PLACEHOLDER_UI_PORT=8090
